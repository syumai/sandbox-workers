{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sandbox-perl",
  "main": "runtime/worker.js",
  "compatibility_date": "2026-09-04",
  "workers_dev": false,
  "preview_urls": false,
  "limits": {
    "cpu_ms": 2000
  },
  "build": {
    "command": "pnpm run build"
  },
  "rules": [
    {
      "type": "Data",
      "globs": [
        "**/*.bin"
      ],
      "fallthrough": true
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "SANDBOX",
        "class_name": "Sandbox"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "Sandbox"
      ]
    }
  ]
}
