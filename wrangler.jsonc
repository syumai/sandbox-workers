{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sandbox-workers",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-04",
  "workers_dev": false,
  "preview_urls": false,
  // Served on the custom domain only; the workers.dev subdomain is disabled.
  "routes": [{ "pattern": "sandbox-workers.syumai.dev", "custom_domain": true }],
  "assets": {
    "directory": "dist/ui",
    "binding": "ASSETS",
    "run_worker_first": ["/execute", "/languages", "/languages/*"],
  },
  "services": [
    { "binding": "JAVASCRIPT", "service": "sandbox-engine-javascript" },
    { "binding": "PYTHON", "service": "sandbox-engine-python" },
    { "binding": "PERL", "service": "sandbox-engine-perl" },
    { "binding": "RUBY", "service": "sandbox-engine-ruby" },
  ],
  // The gateway is an ordinary caller of @sandbox-workers/core: it hosts its
  // own Sandbox Durable Object (see src/index.ts, docs/sandbox-1-0-design.md).
  "durable_objects": { "bindings": [{ "name": "Sandbox", "class_name": "Sandbox" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Sandbox"] }],
  // Short here so the public Playground reclaims sandboxes quickly.
  "vars": { "SANDBOX_IDLE_TTL_MS": "3600000" },
}
