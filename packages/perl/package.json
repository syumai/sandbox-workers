      "import": "./dist/worker.js"
    },
    "./metadata": {
      "types": "./dist/metadata.d.ts",
      "import": "./dist/metadata.js"
    }
  },
  "types": "./dist/worker.d.ts",
  "bin": {
    "sandbox-workers-perl": "./bin/init.mjs"
  },
  "engines": {
    "node": ">=22.12"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepack": "node bin/verify.mjs"
  }
