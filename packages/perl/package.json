{
  "name": "@sandbox-workers/perl",
  "version": "0.1.0",
  "description": "Deployable Perl WebAssembly sandbox for Cloudflare Workers Service Bindings",
  "type": "module",
  "license": "SEE LICENSE IN THIRD_PARTY_NOTICES.md",
  "files": [
    "dist",
    "bin",
    "src",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "licenses"
  ],
  "exports": {
    ".": {
