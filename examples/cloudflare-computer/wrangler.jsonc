{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sandbox-computer-example",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-04",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [{ "name": "COMPUTERS", "class_name": "SandboxComputer" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SandboxComputer"] }],
  "services": [
    { "binding": "JAVASCRIPT", "service": "sandbox-engine-javascript" },
    { "binding": "PYTHON", "service": "sandbox-engine-python" },
    { "binding": "PERL", "service": "sandbox-engine-perl" },
    { "binding": "RUBY", "service": "sandbox-engine-ruby" },
  ],
}
