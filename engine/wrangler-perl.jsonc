{
  "name": "sandbox-engine-perl",
  "main": "perl.ts",
  "compatibility_date": "2026-09-04",
  "workers_dev": false,
  "preview_urls": false,
  "limits": {
    "cpu_ms": 2000
  },
  "rules": [
    {
      "type": "Data",
      "globs": [
        "**/*.bin"
      ],
      "fallthrough": true
    }
  ]
}
