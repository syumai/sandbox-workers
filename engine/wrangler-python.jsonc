{
  "name": "sandbox-engine-python",
  "main": "python.ts",
  "compatibility_date": "2026-09-04",
  "workers_dev": false,
  "preview_urls": false,
  "limits": {
    "cpu_ms": 2000
  },
  "rules": [
    {
      "type": "Data",
      "globs": [
        "**/*.bin"
      ],
      "fallthrough": true
    }
  ],
  "durable_objects": { "bindings": [{ "name": "SESSIONS", "class_name": "SandboxSession" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SandboxSession"] }]
}
