{
  "name": "sandbox-workers",
  "private": true,
  "type": "module",
  "scripts": {
    "build:ui": "vite build && pnpm build:docs",
    "build": "pnpm run build:languages && pnpm run build:packages && pnpm run build:ui",
    "dev": "pnpm run build && wrangler dev -c wrangler.jsonc -c engine/wrangler.jsonc -c engine/wrangler-python.jsonc -c engine/wrangler-perl.jsonc -c engine/wrangler-ruby.jsonc",
    "check": "pnpm --filter @sandbox-workers/core build && pnpm --filter @sandbox-workers/interpreter build && tsc --noEmit",
    "test": "pnpm --filter @sandbox-workers/core build && pnpm --filter @sandbox-workers/interpreter build && node --test tests/*.test.mjs",
    "dry-run": "pnpm run build && node scripts/dry-run.mjs",
    "test:http": "node tests/http.mjs",
    "test:sandboxes": "node tests/sandboxes.mjs",
    "test:caller": "node tests/caller.mjs",
    "dev:caller": "wrangler dev -c tests/fixtures/caller/wrangler.jsonc -c engine/wrangler.jsonc -c engine/wrangler-python.jsonc --port 8798",
    "test:stateless": "node tests/stateless.mjs",
    "dev:stateless": "wrangler dev -c tests/fixtures/stateless/wrangler.jsonc -c tests/fixtures/stateless/engine-wrangler.jsonc --port 8799",
    "test:custom-runtime": "node tests/custom-runtime.mjs",
    "dev:custom-runtime": "wrangler dev -c tests/fixtures/custom-runtime/wrangler.jsonc -c tests/fixtures/custom-runtime/runtime-wrangler.jsonc --port 8800",
    "deploy:engine": "wrangler deploy -c engine/wrangler.jsonc",
    "deploy:gateway": "wrangler deploy",
    "build:packages": "pnpm --filter @sandbox-workers/core build && pnpm --filter @sandbox-workers/interpreter build && node scripts/build-packages.mjs",
    "pack": "pnpm build && node scripts/pack.mjs",
    "test:package": "node tests/package.mjs && node tests/package-languages.mjs",
    "build:languages": "node scripts/fetch-languages.mjs && node --max-old-space-size=8192 scripts/meter-languages.mjs javascript python perl ruby",
    "deploy:engines": "pnpm run deploy:engine && wrangler deploy -c engine/wrangler-python.jsonc && wrangler deploy -c engine/wrangler-perl.jsonc && wrangler deploy -c engine/wrangler-ruby.jsonc",
    "build:docs": "pnpm --filter @sandbox-workers/docs build && node scripts/copy-docs.mjs",
    "docs:dev": "pnpm --filter @sandbox-workers/docs dev",
    "docs:check": "pnpm --filter @sandbox-workers/docs validate",
    "templates:generate": "node scripts/generate-templates.mjs",
    "test:templates": "node scripts/test-templates.mjs"
  },
  "dependencies": {
    "@codemirror/lang-javascript": "^6.2.4",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.11.0",
    "@codemirror/legacy-modes": "^6.5.4",
    "@codemirror/state": "^6.5.2",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.38.0",
    "@sandbox-workers/core": "workspace:*",
    "@sandbox-workers/interpreter": "workspace:*",
    "@sandbox-workers/javascript": "workspace:*",
    "@sandbox-workers/perl": "workspace:*",
    "@sandbox-workers/python": "workspace:*",
    "@sandbox-workers/ruby": "workspace:*",
    "codemirror": "^6.0.2"
  },
  "devDependencies": {
    "@bjorn3/browser_wasi_shim": "^0.4.2",
    "@cloudflare/workers-types": "latest",
    "@ruby/4.0-wasm-wasi": "2.10.1",
    "@ruby/wasm-wasi": "2.10.1",
    "binaryen": "^132.0.0",
    "esbuild": "^0.28.2",
    "fflate": "^0.8.3",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "vite": "latest",
    "wrangler": "latest"
  },
  "license": "MIT",
  "packageManager": "pnpm@10.7.1"
}
